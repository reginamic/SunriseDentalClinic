<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0">

    <!--
        Sunrise Dental Clinic Management System

        Servlet controllers are registered using @WebServlet
        annotations. This deployment descriptor is used for
        application-level session security configuration.
    -->


    <!-- ======================================================
         SESSION MANAGEMENT
         ====================================================== -->

    <session-config>

        <!--
            Automatically expire an inactive authenticated
            session after 30 minutes.
        -->
        <session-timeout>30</session-timeout>


        <cookie-config>

            <!--
                Prevent JavaScript from reading the session cookie.
                This reduces exposure if client-side script is
                compromised.
            -->
            <http-only>true</http-only>

        </cookie-config>


        <!--
            Use cookies for session tracking instead of exposing
            the session identifier in rewritten URLs.
        -->
        <tracking-mode>COOKIE</tracking-mode>

    </session-config>


    <!-- ======================================================
         APPLICATION WELCOME PAGE
         ====================================================== -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>